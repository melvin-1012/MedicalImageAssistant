# ============================================================
# MediVision AI - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ----- Supabase (Cloud PostgreSQL) -----
SUPABASE_URL=https://your-project-id.supabase.co
# You can supply SUPABASE_KEY directly or supply both anon & service-role keys:
SUPABASE_KEY=your-supabase-key-here
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- JWT (use your Supabase JWT secret) -----
JWT_SECRET=your-supabase-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- App -----
APP_NAME=MediVision AI
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ----- Supabase Storage Buckets -----
STORAGE_BUCKET_IMAGES=medical-images
STORAGE_BUCKET_REPORTS=medical-reports
STORAGE_BUCKET_ANALYSIS=analysis-results

# ----- AI Services (plug in real models here later) -----
VISION_AI_ENABLED=false
GENAI_ENABLED=false
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# VISION_MODEL_ENDPOINT=
